<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tn_bg</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>

        <item name="postSplashScreenTheme">@style/Theme.SteamDealsAlert</item>
    </style>

    <style name="Base.Theme.SteamDealsAlert" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tn_purple</item>
        <item name="colorOnPrimary">@color/tn_bg</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/tn_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@color/tn_bg</item>
    </style>

    <style name="Theme.SteamDealsAlert" parent="Base.Theme.SteamDealsAlert" />

</resources>